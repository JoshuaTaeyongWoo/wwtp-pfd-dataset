<!--
Label Studio labeling config for the WWTP diagram pilot (taxonomy v1.1, tier-1 fields + a few tier-2).
Generated by hand from annotation/classes.yaml on 2026-11-17.

How to use: Label Studio > Create project > Labeling Setup > Code > paste this file.
Boxes: pick the class, draw. Per-box fields appear when a box is selected (perRegion).
Edges: select the source box, press "r" (relation), click the target box, then pick the relation
label (medium / direction_confidence). Zones: draw the zone box, relate it to the parent tank with
the "parent_of" relation (parent -> zone).
-->
<View>
  <Style>
    .ls-root { font-family: "Noto Sans KR", sans-serif; }
    .hdr { font-weight: 700; margin: 6px 0 2px; }
  </Style>

  <Header value="1. 라벨 버튼을 먼저 누르고 그림 위에서 드래그 (숫자키 1~0 = 자주 쓰는 클래스, Alt+R = 연결)"/>
  <RectangleLabels name="unit" toName="img" showInline="true" strokeWidth="2" opacity="0.15">
    <!-- preliminary -->
    <Label value="screen" background="#1f77b4" hotkey="1"/>
    <Label value="grit_chamber" background="#1f77b4"/>
    <Label value="equalization_tank" background="#1f77b4"/>
    <Label value="pump_station" background="#1f77b4"/>
    <!-- primary / separation -->
    <Label value="primary_clarifier" background="#8c564b" hotkey="2"/>
    <Label value="flotation_unit" background="#8c564b"/>
    <Label value="chemical_treatment_unit" background="#8c564b"/>
    <!-- secondary zones and units -->
    <Label value="aerobic_zone" background="#2ca02c" hotkey="3"/>
    <Label value="anoxic_zone" background="#2ca02c" hotkey="4"/>
    <Label value="anaerobic_zone" background="#2ca02c" hotkey="5"/>
    <Label value="secondary_clarifier" background="#2ca02c" hotkey="6"/>
    <Label value="mbr_unit" background="#2ca02c"/>
    <Label value="sbr_tank" background="#2ca02c"/>
    <Label value="biofilm_reactor/trickling_filter" background="#17becf"/>
    <Label value="biofilm_reactor/rbc" background="#17becf"/>
    <Label value="biofilm_reactor/submerged_biofilter" background="#17becf"/>
    <Label value="biofilm_reactor/mbbr_ifas" background="#17becf"/>
    <Label value="biofilm_reactor/fluidized_expanded_bed" background="#17becf"/>
    <Label value="biofilm_reactor/mabr" background="#17becf"/>
    <Label value="anaerobic_wastewater_reactor/uasb_egsb_ic" background="#9467bd"/>
    <Label value="anaerobic_wastewater_reactor/anaerobic_filter" background="#9467bd"/>
    <Label value="anaerobic_wastewater_reactor/anaerobic_contact" background="#9467bd"/>
    <Label value="anaerobic_wastewater_reactor/anaerobic_cstr" background="#9467bd"/>
    <Label value="anaerobic_wastewater_reactor/abr" background="#9467bd"/>
    <Label value="anaerobic_wastewater_reactor/anaerobic_mbr" background="#9467bd"/>
    <Label value="pond_lagoon_wetland" background="#bcbd22"/>
    <!-- sidestream / tertiary -->
    <Label value="sidestream_reactor" background="#e377c2"/>
    <Label value="filtration_unit" background="#ff7f0e" hotkey="7"/>
    <Label value="membrane_unit" background="#ff7f0e"/>
    <Label value="disinfection_unit" background="#ff7f0e" hotkey="8"/>
    <!-- sludge -->
    <Label value="fermenter" background="#7f7f7f"/>
    <Label value="thickener" background="#7f7f7f" hotkey="9"/>
    <Label value="digester" background="#7f7f7f" hotkey="0"/>
    <Label value="dewatering_unit" background="#7f7f7f"/>
    <Label value="drying_incineration_unit" background="#7f7f7f"/>
    <Label value="biogas_unit" background="#7f7f7f"/>
    <!-- ancillary -->
    <Label value="pump" background="#d62728"/>
    <Label value="blower" background="#d62728"/>
    <Label value="storage_tank" background="#d62728"/>
    <Label value="valve" background="#d62728"/>
    <Label value="aerator_mixer_symbol" background="#d62728"/>
    <!-- generic -->
    <Label value="process_unit_generic" background="#000000"/>
    <Label value="unknown_equipment" background="#000000"/>
    <!-- connection / annotation classes -->
    <Label value="arrowhead" background="#ffbb78"/>
    <Label value="text_label" background="#aec7e8"/>
    <Label value="stream_tag" background="#aec7e8"/>
    <Label value="stream_label" background="#aec7e8"/>
    <Label value="io_terminal" background="#ff9896"/>
    <Label value="junction_split" background="#ff9896"/>
    <Label value="junction_merge" background="#ff9896"/>
    <Label value="instrument" background="#c5b0d5"/>
  </RectangleLabels>

  <Image name="img" value="$image" zoom="true" zoomControl="true" rotateControl="false" brightnessControl="true"/>


  <Header value="2. 박스 속성 (박스를 선택하면 나타남) — T1 필수"/>
  <View style="display:flex; gap:12px; flex-wrap:wrap">
    <Choices name="visual_form" toName="img" perRegion="true" required="false" showInline="true">
      <Header value="visual_form"/>
      <Choice value="symbol"/><Choice value="box"/><Choice value="pictorial"/><Choice value="simulator_icon"/><Choice value="section_view"/>
    </Choices>
    <Choices name="confidence" toName="img" perRegion="true" showInline="true">
      <Header value="confidence"/>
      <Choice value="certain"/><Choice value="inferred_from_text"/><Choice value="inferred_from_context"/>
    </Choices>
    <Choices name="is_zone" toName="img" perRegion="true" showInline="true">
      <Header value="is_zone (구역 박스면 체크)"/>
      <Choice value="zone"/>
    </Choices>
    <Choices name="l1_hint" toName="img" perRegion="true" showInline="true">
      <Header value="l1_hint (generic·unknown 박스만: 어느 단계인가)"/>
      <Choice value="preliminary"/><Choice value="primary"/><Choice value="secondary"/><Choice value="tertiary"/><Choice value="sludge"/><Choice value="sidestream"/><Choice value="unknown"/>
    </Choices>
    <Choices name="graph_id" toName="img" perRegion="true" showInline="true">
      <Header value="graph_id (독립 도면이 둘 이상일 때만)"/>
      <Choice value="g1"/><Choice value="g2"/><Choice value="g3"/><Choice value="g4"/>
    </Choices>
  </View>
  <TextArea name="label_text" toName="img" perRegion="true" placeholder="박스 안·옆 원문 텍스트 (번호 포함)" maxSubmissions="1" editable="true"/>

  <Header value="3. 박스 속성 — T2 (텍스트·캡션에 명시된 경우만, 아니면 비움)"/>
  <View style="display:flex; gap:12px; flex-wrap:wrap">
    <Choices name="treatment_line" toName="img" perRegion="true" showInline="true">
      <Header value="treatment_line"/><Choice value="mainstream"/><Choice value="sidestream"/><Choice value="sludge"/>
    </Choices>
    <Choices name="zone_role" toName="img" perRegion="true" showInline="true">
      <Header value="zone_role"/><Choice value="main"/><Choice value="selector"/><Choice value="contact"/><Choice value="reaeration"/><Choice value="deoxygenation"/><Choice value="degasifier"/><Choice value="underflow_anoxic"/><Choice value="post_anoxic"/><Choice value="stripper"/><Choice value="swing"/>
    </Choices>
    <Choices name="aeration_mode" toName="img" perRegion="true" showInline="true">
      <Header value="aeration_mode"/><Choice value="diffused"/><Choice value="surface"/><Choice value="brush"/><Choice value="jet"/><Choice value="hpo"/><Choice value="membrane"/><Choice value="mixer_only"/><Choice value="none"/>
    </Choices>
    <Choices name="operation_mode" toName="img" perRegion="true" showInline="true">
      <Header value="operation_mode"/><Choice value="continuous"/><Choice value="sequencing"/><Choice value="alternating"/><Choice value="intermittent"/>
    </Choices>
    <Choices name="redox_condition" toName="img" perRegion="true" showInline="true">
      <Header value="redox_condition (생물막)"/><Choice value="aerobic"/><Choice value="anoxic"/><Choice value="anaerobic"/>
    </Choices>
    <Choices name="clarifier_stage" toName="img" perRegion="true" showInline="true">
      <Header value="clarifier_stage"/><Choice value="primary"/><Choice value="intermediate"/><Choice value="secondary"/><Choice value="chemical"/>
    </Choices>
    <Choices name="digester_type" toName="img" perRegion="true" showInline="true">
      <Header value="digester_type"/><Choice value="anaerobic"/><Choice value="aerobic"/><Choice value="atad"/><Choice value="two_stage"/><Choice value="acid_phase"/><Choice value="thp_fed"/>
    </Choices>
    <Choices name="function" toName="img" perRegion="true" showInline="true">
      <Header value="function (부상조)"/><Choice value="primary"/><Choice value="secondary_separation"/><Choice value="tertiary"/><Choice value="thickening"/>
    </Choices>
    <Choices name="io_role" toName="img" perRegion="true" showInline="true">
      <Header value="io_role (io_terminal)"/><Choice value="raw_influent"/><Choice value="settled_influent"/><Choice value="external_waste_in"/><Choice value="effluent"/><Choice value="reclaimed_water_out"/><Choice value="solids_disposal"/><Choice value="biogas_use"/><Choice value="off_gas_out"/><Choice value="chemical_source"/><Choice value="overflow_bypass_out"/><Choice value="external_sidestream"/><Choice value="continuation"/>
    </Choices>
    <Choices name="stream_role" toName="img" perRegion="true" showInline="true">
      <Header value="stream_role (stream_label)"/><Choice value="influent"/><Choice value="settled_influent"/><Choice value="effluent"/><Choice value="reclaimed_water"/><Choice value="mixed_liquor"/><Choice value="internal_recycle_a"/><Choice value="ras_s"/><Choice value="r_recycle"/><Choice value="effluent_recirculation_qr"/><Choice value="was"/><Choice value="scum"/><Choice value="primary_sludge"/><Choice value="thickened_sludge"/><Choice value="digested_sludge"/><Choice value="dewatered_cake"/><Choice value="chemical_sludge"/><Choice value="screenings_grit"/><Choice value="fermentate"/><Choice value="co_substrate"/><Choice value="sidestream_return"/><Choice value="backwash_return"/><Choice value="bypass"/><Choice value="overflow"/><Choice value="step_feed"/><Choice value="biogas"/><Choice value="off_gas"/><Choice value="air_supply"/><Choice value="oxygen"/><Choice value="chemical_dose"/><Choice value="carbon_source"/><Choice value="signal"/>
    </Choices>
    <Choices name="split_type" toName="img" perRegion="true" showInline="true">
      <Header value="split_type"/><Choice value="ratio"/><Choice value="fraction"/><Choice value="pumped"/><Choice value="bypass"/><Choice value="router_alternating"/><Choice value="pacing"/>
    </Choices>
    <Choices name="merge_role" toName="img" perRegion="true" showInline="true">
      <Header value="merge_role"/><Choice value="step_feed_inlet"/><Choice value="sidestream_return"/><Choice value="chemical_dosing_point"/><Choice value="recycle_return"/><Choice value="lane_combiner"/>
    </Choices>
    <Choices name="tag_kind" toName="img" perRegion="true" showInline="true">
      <Header value="tag_kind (text_label / stream_tag)"/><Choice value="name"/><Choice value="volume"/><Choice value="depth"/><Choice value="equipment_count"/><Choice value="hrt"/><Choice value="spec"/><Choice value="material"/><Choice value="capacity"/><Choice value="patent_number"/><Choice value="stream_no"/><Choice value="flow"/><Choice value="fraction"/><Choice value="concentration"/><Choice value="loading"/><Choice value="performance"/><Choice value="quality"/><Choice value="hydraulic"/><Choice value="other"/>
    </Choices>
  </View>
  <TextArea name="n_compartments" toName="img" perRegion="true" placeholder="n_compartments / n_parallel_lanes / lane_group_id / panel_phase (예: n=3; lanes=2; lane=1; phase=react)" maxSubmissions="1" editable="true"/>

  <Header value="4. 연결 (엣지): 출발 박스 선택 → Alt+R → 도착 박스 클릭 → 관계 라벨: medium|방향 하나 + (점선이면 style:dashed, 선택 경로면 optional)"/>
  <Relations>
    <!-- medium ∥ direction_confidence ; parent_of links a tank to its zone boxes (tank -> zone) -->
    <Relation value="liquid|arrowhead"/>
    <Relation value="liquid|inferred"/>
    <Relation value="liquid|ambiguous"/>
    <Relation value="mixed_liquor|arrowhead"/>
    <Relation value="mixed_liquor|inferred"/>
    <Relation value="sludge|arrowhead"/>
    <Relation value="sludge|inferred"/>
    <Relation value="gas|arrowhead"/>
    <Relation value="gas|inferred"/>
    <Relation value="air|arrowhead"/>
    <Relation value="air|inferred"/>
    <Relation value="chemical|arrowhead"/>
    <Relation value="chemical|inferred"/>
    <Relation value="solid|arrowhead"/>
    <Relation value="signal|arrowhead"/>
    <Relation value="signal|inferred"/>
    <Relation value="style:dashed"/>
    <Relation value="style:dotted"/>
    <Relation value="optional"/>
    <Relation value="parent_of"/>
    <Relation value="evidence_for"/>
  </Relations>

  <Header value="5. 이미지 속성 — T1"/>
  <View style="display:flex; gap:12px; flex-wrap:wrap">
    <Choices name="diagram_style" toName="img" showInline="true" required="true">
      <Header value="diagram_style"/><Choice value="A_box"/><Choice value="B_symbol"/><Choice value="C_pictorial"/><Choice value="D_simulator"/><Choice value="E_page"/><Choice value="hydraulic_profile"/>
    </Choices>
    <Choices name="language" toName="img" showInline="true" required="true">
      <Header value="language"/><Choice value="en"/><Choice value="ko"/><Choice value="zh"/><Choice value="ja"/><Choice value="other"/><Choice value="mixed"/>
    </Choices>
    <Number name="n_panels" toName="img" min="1" max="12" defaultValue="1" hint="독립 도면 수"/>
  </View>
  <TextArea name="process_configuration" toName="img" placeholder="process_configuration: 캡션·제목의 공정 명칭 원문 (예: A2O + MBR, MLE, 4-stage Bardenpho) — 없으면 비움" maxSubmissions="1" editable="true"/>
  <TextArea name="annotator_note" toName="img" placeholder="판단이 어려웠던 점 (판정자에게 전달)" maxSubmissions="1" editable="true"/>
</View>
