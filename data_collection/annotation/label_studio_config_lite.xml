  <Image name="img" value="$image" zoom="true" zoomControl="true" rotateControl="false" brightnessControl="true"/>

  <View className="attrs" style="display:flex; gap:12px; flex-wrap:wrap">
    <Choices name="visual_form" toName="img" perRegion="true" showInline="true">
      <Header value="visual_form"/>
      <Choice value="symbol" hotkey=" "/><Choice value="box" hotkey=" "/><Choice value="pictorial" hotkey=" "/><Choice value="simulator_icon" hotkey=" "/><Choice value="section_view" hotkey=" "/>
    </Choices>
    <Choices name="confidence" toName="img" perRegion="true" showInline="true">
