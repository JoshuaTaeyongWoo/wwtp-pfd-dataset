    <RectangleLabels name="g7_aux" toName="img" showInline="true" strokeWidth="2" opacity="0.15">
      <Label value="pump" background="#d62728" hotkey="a"/>
      <Label value="blower" background="#d62728" hotkey=" "/>
      <Label value="storage_tank" background="#d62728" hotkey=" "/>
      <Label value="valve" background="#d62728" hotkey=" "/>
      <Label value="aerator_mixer_symbol" background="#d62728" hotkey=" "/>
