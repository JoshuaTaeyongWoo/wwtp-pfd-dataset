    <Panel value="1~20번 완전판에서만: 화살촉·글자 박스">
      <RectangleLabels name="g11_full" toName="img" showInline="true" strokeWidth="2" opacity="0.15">
        <Label value="arrowhead" background="#ffbb78" hotkey=" "/>
